{
  "name": "@artefact/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Transport-agnostic task domain exposed through tRPC. No Next.js dependency.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/modules/tasks/task.schema.ts",
      "default": "./src/modules/tasks/task.schema.ts"
    },
    "./constants": {
      "types": "./src/modules/tasks/task.constants.ts",
      "default": "./src/modules/tasks/task.constants.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@trpc/server": "^11.27.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^3.2.7"
  }
}
